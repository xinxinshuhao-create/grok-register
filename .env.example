# YesCaptcha（必填）
YESCAPTCHA_KEY="your_yescaptcha_key"

# 邮箱提供商：gptmail / luckmail / mailnest / tmail / fce（默认 luckmail；gptmail 与 tmail 需有头 Chrome 过 CF 验证，fce 纯 API 免浏览器）
EMAIL_PROVIDER="luckmail"

# FreeCustom.Email 配置（provider=fce 时需要，免费注册 https://www.freecustom.email/auth）
FCE_API_KEY=""

# Outlook +tag 别名配置（provider=outlook 时需要，XOAUTH2 直读 IMAP）
# OUTLOOK_ACCOUNTS="your@outlook.com,another@hotmail.com"
# OUTLOOK_TOKENS_FILE="outlook_tokens.json"

# Gmail IMAP 收信（provider=gmail 时需要，用 +alias 衍生邮箱）
GMAIL_BASE_EMAIL=""
GMAIL_APP_PASSWORD=""

# Grok 注册线程数（可选）
THREADS="1"

# LuckMail 配置（仅在 EMAIL_PROVIDER=luckmail 时需要）
# LUCKMAIL_BASE_URL 已内置为 https://mails.luckyous.com，只有使用别的站点时才需要覆盖
# LUCKMAIL_BASE_URL="https://mails.luckyous.com"
LUCKMAIL_API_KEY="your_luckmail_api_key"
LUCKMAIL_API_SECRET=""
LUCKMAIL_USE_HMAC="false"
LUCKMAIL_PROJECT_CODE="grok"
LUCKMAIL_EMAIL_TYPE="ms_imap"
LUCKMAIL_DOMAIN="outlook.com"

# MailNest 配置（仅在 EMAIL_PROVIDER=mailnest 时需要）
# 获取 apikey：https://mailnest.top/account
# 获取项目代码：https://mailnest.top/buy-email 默认为 x-ai001 可直接使用
MAILNEST_API_KEY="your_mailnest_api_key"
MAILNEST_PROJECT_CODE="x-ai001"

# 可选代理示例（如需可自行启用）
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"

# 注册/铸造用 Clash 代理（grok.py 等脚本的出口代理）
# GROK_PROXY="http://127.0.0.1:7897"

# 真实住宅代理（device_consent.py / poll_tokens.py 需要，缺省报错退出）
# CLIPROXY=""

# CPA auths 输出目录（默认 D:\CLIProxyAPIPlus\auths，其他机器可覆盖）
# CPA_AUTHS_DIR=""

# Clash 外部控制器（clash_rotator.py）
# CLASH_SECRET=""
# CLASH_PROXY_GROUP="落云"

# remint_oauth.py 要重铸的邮箱列表（逗号分隔，缺省为空则不处理）
# REMINT_EMAILS=""
